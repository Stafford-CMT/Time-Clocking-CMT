NODE_ENV=production
PORT=4100

# PostgreSQL — a dedicated database + login for this app on your Postgres server
DB_HOST=localhost
DB_PORT=5432
DB_NAME=time_clocking
DB_USER=time_clocking_app
DB_PASSWORD=
DB_SSL=false

# Session
SESSION_SECRET=
SESSION_MAX_AGE_MS=604800000

# Azure AD (Entra ID) app registration — Azure Portal -> App registrations
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://your-hostname/auth/callback
POST_LOGOUT_REDIRECT_URI=https://your-hostname/login.html

# Server-side allowlist on top of Azure AD itself (comma-separated, no spaces)
ALLOWED_EMAIL_DOMAINS=cliffeng.com
