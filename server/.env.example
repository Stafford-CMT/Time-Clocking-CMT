NODE_ENV=production
# Live server: 4004 (IO Buddy 4000, Gantt 4001, MecHub 4002, Training Matrix 4003).
# A development PC can use 4100, which matches the localhost sign-in addresses.
PORT=4004

# PostgreSQL — a dedicated database + login for this app on your Postgres server
DB_HOST=localhost
DB_PORT=5432
DB_NAME=time_clocking
DB_USER=time_clocking_app
DB_PASSWORD=
DB_SSL=false

# Session
SESSION_SECRET=
SESSION_MAX_AGE_MS=604800000

# Encrypts the Syspro passwords saved in Setup -> Configuration. 64 hex characters;
# make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe -- if it changes, the saved passwords must be typed in again.
SETTINGS_ENCRYPTION_KEY=

# Azure AD (Entra ID) app registration — Azure Portal -> App registrations
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://your-hostname/auth/callback
POST_LOGOUT_REDIRECT_URI=https://your-hostname/login.html

# Server-side allowlist on top of Azure AD itself (comma-separated, no spaces)
ALLOWED_EMAIL_DOMAINS=cliffeng.com

# LOCAL DEVELOPMENT ONLY -- signs you straight in as this email, skipping
# Microsoft (the AZURE_* values can then be left blank). The server refuses
# to start if this is set together with NODE_ENV=production.
# DEV_LOGIN_EMAIL=you@cliffeng.com
# Optional: the name to show for that account (otherwise built from the email).
# DEV_LOGIN_NAME=Your Name

# Development only: fill Lists -> Users with made-up staff instead of reading
# Microsoft Entra ID (e.g. before admin consent for User.Read.All is granted).
# Refused when NODE_ENV=production.
# DIRECTORY_SAMPLE=true
# How often to read staff from Microsoft, in minutes (default 30).
# DIRECTORY_SYNC_MINUTES=30

# Commit reminder emails (Setup -> Data export). The mailbox they are sent
# from; needs Microsoft Graph application permission Mail.Send with admin
# consent. Without it the "Email reminders" button explains what is missing.
# MAIL_FROM=timeslide@example.com
# Link in the email (defaults to the site in AZURE_REDIRECT_URI).
# APP_URL=https://timeslide.example.com
